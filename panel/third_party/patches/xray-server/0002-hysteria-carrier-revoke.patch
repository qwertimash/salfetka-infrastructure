+// AuthenticateAndTrack is the admission linearization point. Revocation denies
+// the incarnation before closing its whole QUIC carriers, including all streams.
+func (v *Validator) AuthenticateAndTrack(auth string, close func()) (*protocol.MemoryUser, func()) {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	u := v.Get(auth)
+	if v.closed || u == nil || close == nil {
+		return nil, nil
+	}
+	owner := v.GetByEmail(u.Email)
+	sessions, ok := v.sessions[owner]
+	if !ok {
+		return nil, nil
+	}
+	v.next++
+	id := v.next
+	sessions[id] = close
+	return u, func() { v.mu.Lock(); delete(v.sessions[owner], id); v.mu.Unlock() }
+}
+
+func (v *Validator) Close() error {
+	v.mu.Lock()
+	v.closed = true
+	owned := v.sessions
+	v.sessions = nil
+	v.users.Clear()
+	v.ids.Clear()
+	v.mu.Unlock()
+	for _, sessions := range owned {
+		for _, close := range sessions {
+			close()
+		}
+	}
+	return nil
+}
