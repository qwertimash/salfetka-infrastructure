# Enroll the identity first; initialize the explicitly owned VPN installation.
PANEL_NODE_EXPECTED_ID=00000000-0000-4000-8000-000000000001
PANEL_NODE_STATE_DIR=/var/lib/salfetka-vpn-node/identity
PANEL_NODE_PANEL_URL=https://panel.example.invalid
PANEL_NODE_CA_FILE=/etc/salfetka-vpn-node/server-ca.crt
PANEL_NODE_SIGNER_PUBLIC_FILE=/etc/salfetka-vpn-node/signer.pub
PANEL_VPN_INSTALLATION_ID=00000000-0000-4000-8000-000000000002
PANEL_VPN_STATE_DIR=/var/lib/salfetka-vpn-node/engine
PANEL_VPN_LISTEN_IP=0.0.0.0
PANEL_VPN_PORT=14443
PANEL_VPN_CERT_FILE=/etc/salfetka-vpn-node/vpn.crt
PANEL_VPN_KEY_FILE=/etc/salfetka-vpn-node/vpn.key

# Empty preserves VLESS. Set hysteria2 only on a separate new installation.
PANEL_VPN_BACKEND=
