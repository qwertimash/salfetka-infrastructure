+func (m *clientManager) cleanOnce() {
+	// A client's mutex may be held by a network handshake. Only snapshot map
+	// membership here; waiting for that client must not block another owner's
+	// registration or cleanup. The client mutex protects each retained pointer.
+	m.RLock()
+	clients := make([]*client, 0, len(m.m))
+	for _, c := range m.m {
+		clients = append(clients, c)
+	}
+	m.RUnlock()
+	for _, c := range clients {
+		c.clean()
+	}
+}
+
+func (m *clientManager) closeClient(key dialerConf, owned *client) {
+	m.Lock()
+	if m.m[key] == owned {
+		delete(m.m, key)
+	}
+	m.Unlock()
+	owned.Lock()
+	owned.closed = true
+	if owned.conn != nil {
+		owned.close()
+	}
+	owned.Unlock()
 }
 
