diff --git a/transport/internet/salfetka_dialer_cleanup.go b/transport/internet/salfetka_dialer_cleanup.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_dialer_cleanup.go
@@ -0,0 +1,33 @@
+package internet
+
+// Every outbound owns a distinct parsed MemoryStreamConfig. Closing it fences
+// new cache entries first, then closes only the clients registered by that exact
+// config (including its lazily created download config). No global cache clear.
+func (s *MemoryStreamConfig) DialerClosed() bool {
+	s.dialerCleanupMu.Lock()
+	defer s.dialerCleanupMu.Unlock()
+	return s.dialerClosed
+}
+func (s *MemoryStreamConfig) AddDialerCleanup(cleanup func()) bool {
+	s.dialerCleanupMu.Lock()
+	defer s.dialerCleanupMu.Unlock()
+	if s.dialerClosed {
+		return false
+	}
+	s.dialerCleanups = append(s.dialerCleanups, cleanup)
+	return true
+}
+func (s *MemoryStreamConfig) CloseDialerCaches() {
+	s.dialerCleanupMu.Lock()
+	if s.dialerClosed {
+		s.dialerCleanupMu.Unlock()
+		return
+	}
+	s.dialerClosed = true
+	cleanups := s.dialerCleanups
+	s.dialerCleanups = nil
+	s.dialerCleanupMu.Unlock()
+	for _, cleanup := range cleanups {
+		cleanup()
+	}
+}
diff --git a/transport/internet/salfetka_dialer_cleanup_test.go b/transport/internet/salfetka_dialer_cleanup_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_dialer_cleanup_test.go
@@ -0,0 +1,31 @@
+package internet
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestSalfetkaDialerCloseFencesLateRegistration(t *testing.T) {
+	var s MemoryStreamConfig
+	var calls atomic.Int32
+	var workers sync.WaitGroup
+	for i := 0; i < 50; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			if !s.AddDialerCleanup(func() { calls.Add(1) }) {
+				calls.Add(1)
+			}
+		}()
+	}
+	s.CloseDialerCaches()
+	workers.Wait()
+	s.CloseDialerCaches()
+	if calls.Load() != 50 {
+		t.Fatal("cleanup lost/duplicated", calls.Load())
+	}
+	if !s.DialerClosed() || s.AddDialerCleanup(func() { t.Error("late cleanup") }) {
+		t.Fatal("late cache registration admitted")
+	}
+}
