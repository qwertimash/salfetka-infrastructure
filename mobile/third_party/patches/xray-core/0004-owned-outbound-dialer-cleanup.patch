diff --git a/transport/internet/splithttp/salfetka_owned_client.go b/transport/internet/splithttp/salfetka_owned_client.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/splithttp/salfetka_owned_client.go
@@ -0,0 +1,137 @@
+package splithttp
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync"
+)
+
+func (c *DefaultDialerClient) initializeOwner() {
+	c.ownerMu.Lock()
+	defer c.ownerMu.Unlock()
+	c.initializeOwnerLocked()
+}
+func (c *DefaultDialerClient) initializeOwnerLocked() {
+	if c.ownerCtx == nil {
+		c.ownerCtx, c.ownerCancel = context.WithCancel(context.Background())
+		c.ownerConns = make(map[io.Closer]struct{})
+		c.ownerDone = make(chan struct{})
+	}
+}
+func (c *DefaultDialerClient) beginOwnedRequest(ctx context.Context) (context.Context, func(), error) {
+	c.ownerMu.Lock()
+	c.initializeOwnerLocked()
+	if c.ownerClosed {
+		c.ownerMu.Unlock()
+		return nil, nil, net.ErrClosed
+	}
+	c.ownerTasks.Add(1)
+	owner := c.ownerCtx
+	c.ownerMu.Unlock()
+	// Preserve XHTTP's per-stream cancellation behavior, but never detach the
+	// request from its transport owner. Owner Close terminates all pending tasks.
+	request, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	stop := context.AfterFunc(owner, cancel)
+	var once sync.Once
+	return request, func() { once.Do(func() { stop(); cancel(); c.ownerTasks.Done() }) }, nil
+}
+func (c *DefaultDialerClient) ownConn(conn net.Conn) (net.Conn, error) {
+	wrapper := &ownedConn{Conn: conn, owner: c}
+	if !c.registerOwned(wrapper) {
+		conn.Close()
+		return nil, net.ErrClosed
+	}
+	return wrapper, nil
+}
+func (c *DefaultDialerClient) ownPacketConn(conn net.PacketConn) (net.PacketConn, error) {
+	wrapper := &ownedPacketConn{PacketConn: conn, owner: c}
+	if !c.registerOwned(wrapper) {
+		conn.Close()
+		return nil, net.ErrClosed
+	}
+	return wrapper, nil
+}
+func (c *DefaultDialerClient) registerOwned(conn io.Closer) bool {
+	c.ownerMu.Lock()
+	defer c.ownerMu.Unlock()
+	c.initializeOwnerLocked()
+	if c.ownerClosed {
+		return false
+	}
+	c.ownerConns[conn] = struct{}{}
+	return true
+}
+func (c *DefaultDialerClient) forgetOwned(conn io.Closer) {
+	c.ownerMu.Lock()
+	delete(c.ownerConns, conn)
+	c.ownerMu.Unlock()
+}
+
+type ownedConn struct {
+	net.Conn
+	owner *DefaultDialerClient
+}
+
+func (c *ownedConn) Close() error { c.owner.forgetOwned(c); return c.Conn.Close() }
+
+type ownedPacketConn struct {
+	net.PacketConn
+	owner *DefaultDialerClient
+}
+
+func (c *ownedPacketConn) Close() error { c.owner.forgetOwned(c); return c.PacketConn.Close() }
+func (c *DefaultDialerClient) Close() error {
+	c.ownerMu.Lock()
+	c.initializeOwnerLocked()
+	done := c.ownerDone
+	if c.ownerClosed {
+		c.ownerMu.Unlock()
+		<-done
+		return nil
+	}
+	c.ownerClosed = true
+	c.closed.Store(true)
+	c.ownerCancel()
+	conns := make([]io.Closer, 0, len(c.ownerConns))
+	for conn := range c.ownerConns {
+		conns = append(conns, conn)
+	}
+	c.ownerConns = nil
+	c.ownerMu.Unlock()
+	for _, conn := range conns {
+		conn.Close()
+	}
+	if c.client != nil {
+		switch transport := c.client.Transport.(type) {
+		case interface{ Close() error }:
+			transport.Close()
+		case interface{ CloseIdleConnections() }:
+			transport.CloseIdleConnections()
+		}
+	}
+	c.ownerTasks.Wait()
+	close(done)
+	return nil
+}
+
+// A download task owns its request context until its body is drained/closed;
+// cancelling immediately after headers would cut a healthy XHTTP tunnel.
+type ownedResponse struct {
+	io.ReadCloser
+	finish func()
+	once   sync.Once
+}
+
+func (r *ownedResponse) Read(b []byte) (int, error) {
+	n, err := r.ReadCloser.Read(b)
+	if err != nil {
+		r.Close()
+	}
+	return n, err
+}
+func (r *ownedResponse) Close() error {
+	var err error
+	r.once.Do(func() { err = r.ReadCloser.Close(); r.finish() })
+	return err
+}
