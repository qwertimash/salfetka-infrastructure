+)
+
+func TestSalfetkaHTTPPoolsCloseExactConfigIncludingRetiredClient(t *testing.T) {
+	dest := xnet.TCPDestination(xnet.LocalHostIP, 1)
+	a := &internet.MemoryStreamConfig{ProtocolSettings: &Config{}}
+	b := &internet.MemoryStreamConfig{ProtocolSettings: &Config{}}
+	first, _, e := getHTTPClient(context.Background(), dest, a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, _, e := getHTTPClient(context.Background(), dest, b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer b.CloseDialerCaches()
+	a.CloseDialerCaches()
+	if !first.IsClosed() || second.IsClosed() {
+		t.Fatal("cross-owner close")
+	}
+	globalDialerAccess.Lock()
+	_, old := globalDialerMap[dialerConf{dest, a}]
+	_, live := globalDialerMap[dialerConf{dest, b}]
+	globalDialerAccess.Unlock()
+	if old || !live {
+		t.Fatal("cache not precisely evicted")
+	}
+	if _, _, e = getHTTPClient(context.Background(), dest, a); !errors.Is(e, io.ErrClosedPipe) {
+		t.Fatal("late cache reopened", e)
+	}
+	var closed bool
+	m := NewXmuxManager(XmuxConfig{}, func() XmuxConn { return &syntheticXmux{closed: &closed} })
+	retired := m.newXmuxClient()
+	retired.Running.Store(1)
+	m.xmuxClients = nil
+	for _, client := range m.takeOwnedClients() {
+		client.XmuxConn.(*syntheticXmux).Close()
+	}
+	if !closed {
+		t.Fatal("retired active client escaped owner")
+	}
+}
+
+type syntheticXmux struct{ closed *bool }
+
+func (c *syntheticXmux) IsClosed() bool { return *c.closed }
+func (c *syntheticXmux) Close() error   { *c.closed = true; return nil }
+func TestSalfetkaHTTPClientCloseCancelsTasksAndOwnedWire(t *testing.T) {
+	client := &DefaultDialerClient{}
+	client.initializeOwner()
+	raw, remote := net.Pipe()
+	defer remote.Close()
+	owned, e := client.ownConn(raw)
+	if e != nil {
+		t.Fatal(e)
+	}
+	ctx, finish, e := client.beginOwnedRequest(context.Background())
+	if e != nil {
+		t.Fatal(e)
+	}
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		defer finish()
+		<-ctx.Done()
+		_, e := owned.Read(make([]byte, 1))
+		if e == nil {
+			t.Error("owned wire remained open")
+		}
+	}()
+	var workers sync.WaitGroup
+	workers.Add(2)
+	for i := 0; i < 2; i++ {
+		go func() { defer workers.Done(); client.Close() }()
+	}
+	all := make(chan struct{})
+	go func() { workers.Wait(); close(all) }()
+	select {
+	case <-all:
+	case <-time.After(time.Second):
+		t.Fatal("owned teardown blocked")
+	}
+	<-finished
+	late, other := net.Pipe()
+	defer other.Close()
+	if _, e = client.ownConn(late); !errors.Is(e, net.ErrClosed) {
+		t.Fatal("late dial not fenced", e)
+	}
+	if _, _, e = client.beginOwnedRequest(context.Background()); !errors.Is(e, net.ErrClosed) {
+		t.Fatal("late task not fenced", e)
+	}
+}
