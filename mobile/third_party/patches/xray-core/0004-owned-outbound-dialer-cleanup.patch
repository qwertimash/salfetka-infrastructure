new file mode 100644
--- /dev/null
+++ b/transport/internet/grpc/salfetka_cache_cleanup_test.go
@@ -0,0 +1,40 @@
+package grpc
+
+import (
+	"context"
+	"errors"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	g "google.golang.org/grpc/connectivity"
+	"io"
+	"testing"
+)
+
+func TestSalfetkaCacheEvictionOwnsExactConfig(t *testing.T) {
+	dest := net.TCPDestination(net.LocalHostIP, 1)
+	a := &internet.MemoryStreamConfig{ProtocolSettings: &Config{}}
+	b := &internet.MemoryStreamConfig{ProtocolSettings: &Config{}}
+	first, e := getGrpcClient(context.Background(), dest, a)
+	if e != nil {
+		t.Fatal(e)
+	}
+	second, e := getGrpcClient(context.Background(), dest, b)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer b.CloseDialerCaches()
+	a.CloseDialerCaches()
+	if first.GetState() != g.Shutdown || second.GetState() == g.Shutdown {
+		t.Fatal("cross-owner close")
+	}
+	globalDialerAccess.Lock()
+	_, old := globalDialerMap[dialerConf{dest, a}]
+	_, live := globalDialerMap[dialerConf{dest, b}]
+	globalDialerAccess.Unlock()
+	if old || !live {
+		t.Fatal("cache not evicted precisely")
+	}
+	if _, e = getGrpcClient(context.Background(), dest, a); !errors.Is(e, io.ErrClosedPipe) {
+		t.Fatal("closed config recreated", e)
+	}
+}
