diff --git a/app/dns/salfetka_owned_context.go b/app/dns/salfetka_owned_context.go
new file mode 100644
--- /dev/null
+++ b/app/dns/salfetka_owned_context.go
@@ -0,0 +1,86 @@
+package dns
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+type dnsOwnerKey struct{}
+type dnsOwner struct {
+	mu        sync.Mutex
+	ctx       context.Context
+	cancel    context.CancelFunc
+	closed    bool
+	tasks     sync.WaitGroup
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func newDNSOwnedContext(ctx context.Context) (context.Context, *dnsOwner) {
+	ctx, cancel := context.WithCancel(ctx)
+	o := &dnsOwner{ctx: ctx, cancel: cancel}
+	return context.WithValue(ctx, dnsOwnerKey{}, o), o
+}
+func beginDNSOwnedTask(ctx context.Context) (context.Context, func(), bool) {
+	o, _ := ctx.Value(dnsOwnerKey{}).(*dnsOwner)
+	if o == nil {
+		return ctx, func() {}, true
+	}
+	o.mu.Lock()
+	if o.closed {
+		o.mu.Unlock()
+		return ctx, func() {}, false
+	}
+	o.tasks.Add(1)
+	o.mu.Unlock()
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(o.ctx, cancel)
+	var once sync.Once
+	return ctx, func() { once.Do(func() { stop(); cancel(); o.tasks.Done() }) }, true
+}
+func detachDNSOwnedTask(ctx context.Context, timeout time.Duration) (context.Context, func(), bool) {
+	detached, cancel := context.WithTimeout(context.WithoutCancel(ctx), timeout)
+	owned, done, ok := beginDNSOwnedTask(detached)
+	return owned, func() { done(); cancel() }, ok
+}
+func inheritDNSOwnedContext(destination, source context.Context) context.Context {
+	o, _ := source.Value(dnsOwnerKey{}).(*dnsOwner)
+	if o == nil {
+		return destination
+	}
+	// DNS contexts deliberately detach from individual requests. Reuse the owner
+	// lifetime without registering one retained cancellation callback per query.
+	return dnsOwnedInheritedContext{Context: o.ctx, values: destination, owner: o}
+}
+
+type dnsOwnedInheritedContext struct {
+	context.Context
+	values context.Context
+	owner  *dnsOwner
+}
+
+func (c dnsOwnedInheritedContext) Value(key any) any {
+	if _, ok := key.(dnsOwnerKey); ok {
+		return c.owner
+	}
+	return c.values.Value(key)
+}
+
+func (c dnsOwnedInheritedContext) AfterFunc(f func()) func() bool {
+	return context.AfterFunc(c.Context, f)
+}
+func (o *dnsOwner) cancelTasks() {
+	if o == nil {
+		return
+	}
+	o.mu.Lock()
+	o.closed = true
+	o.cancel()
+	o.mu.Unlock()
+}
+func (o *dnsOwner) wait() {
+	if o != nil {
+		o.tasks.Wait()
+	}
+}
diff --git a/app/dns/salfetka_owned_transports.go b/app/dns/salfetka_owned_transports.go
new file mode 100644
--- /dev/null
+++ b/app/dns/salfetka_owned_transports.go
@@ -0,0 +1,108 @@
+package dns
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/errors"
+	"net"
+)
+
+func (s *DNS) closeOwnedClients() error {
+	var errs []error
+	s.owner.cancelTasks()
+	for _, client := range s.clients {
+		if closer, ok := client.server.(interface{ Close() error }); ok {
+			if err := closer.Close(); err != nil {
+				errs = append(errs, err)
+			}
+		}
+	}
+	s.owner.wait()
+	for _, client := range s.clients {
+		if cached, ok := client.server.(CachedNameserver); ok {
+			cached.getCacheController().closeOwnedCleanup()
+		}
+	}
+	return errors.Combine(errs...)
+}
+func (c *CacheController) startOwnedCleanup() {
+	c.ownedTimerMu.Lock()
+	defer c.ownedTimerMu.Unlock()
+	if !c.ownedClosed {
+		common.Must(c.cacheCleanup.Start())
+	}
+}
+func (c *CacheController) closeOwnedCleanup() {
+	c.ownedTimerMu.Lock()
+	defer c.ownedTimerMu.Unlock()
+	c.ownedClosed = true
+	c.cacheCleanup.Close()
+}
+func (s *ClassicNameServer) Close() error {
+	s.ownedClosed.Store(true)
+	if s.udpServer != nil {
+		s.udpServer.RemoveRay()
+	}
+	s.ownedTimerMu.Lock()
+	s.requestsCleanup.Close()
+	s.ownedTimerMu.Unlock()
+	s.Lock()
+	s.requests = make(map[uint16]*udpDnsRequest)
+	s.Unlock()
+	return nil
+}
+
+type dnsOwnedConn struct {
+	net.Conn
+	owner *DoHNameServer
+}
+
+func (c *dnsOwnedConn) Close() error {
+	c.owner.ownedMu.Lock()
+	delete(c.owner.ownedConns, c)
+	c.owner.ownedMu.Unlock()
+	return c.Conn.Close()
+}
+func (s *DoHNameServer) ownDNSConn(c net.Conn) (net.Conn, error) {
+	s.ownedMu.Lock()
+	if s.ownedClosed {
+		s.ownedMu.Unlock()
+		c.Close()
+		return nil, context.Canceled
+	}
+	if s.ownedConns == nil {
+		s.ownedConns = make(map[*dnsOwnedConn]struct{})
+	}
+	w := &dnsOwnedConn{Conn: c, owner: s}
+	s.ownedConns[w] = struct{}{}
+	s.ownedMu.Unlock()
+	return w, nil
+}
+func (s *DoHNameServer) Close() error {
+	s.ownedMu.Lock()
+	s.ownedClosed = true
+	conns := make([]*dnsOwnedConn, 0, len(s.ownedConns))
+	for c := range s.ownedConns {
+		conns = append(conns, c)
+	}
+	s.ownedConns = nil
+	s.ownedMu.Unlock()
+	for _, c := range conns {
+		c.Close()
+	}
+	if s.httpClient != nil {
+		s.httpClient.CloseIdleConnections()
+	}
+	return nil
+}
+func (s *QUICNameServer) Close() error {
+	s.Lock()
+	s.closed = true
+	c := s.connection
+	s.connection = nil
+	s.Unlock()
+	if c != nil {
+		return c.CloseWithError(0, "")
+	}
+	return nil
+}
