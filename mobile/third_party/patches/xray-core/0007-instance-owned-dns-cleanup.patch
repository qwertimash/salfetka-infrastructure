+func TestSalfetkaDNSCloseCancelsDetachedStaleRefreshAndRefusesLatePull(t *testing.T) {
+	ctx, owner := newDNSOwnedContext(context.Background())
+	featureOwner := &DNS{ctx: ctx, owner: owner}
+	server := &salfetkaHeldCachedServer{cache: NewCacheController("synthetic-stale", true, true, 0),
+		started: make(chan struct{}), finished: make(chan struct{})}
+	request, requestCancel := context.WithCancel(ctx)
+	defer requestCancel()
+	startDNSPull(request, server, "stale.fixture.", feature.IPOption{IPv4Enable: true})
+	select {
+	case <-server.started:
+	case <-time.After(time.Second):
+		t.Fatal("stale refresh was not admitted")
+	}
+	requestCancel()
+	select {
+	case <-server.finished:
+		t.Fatal("stale refresh inherited foreground request cancellation")
+	default:
+	}
+	closed := make(chan error, 1)
+	go func() { closed <- featureOwner.Close() }()
+	select {
+	case err := <-closed:
+		if err != nil {
+			t.Fatal("owner Close failed", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Close waited for detached eight-second refresh deadline")
+	}
+	select {
+	case <-server.finished:
+	default:
+		t.Fatal("Close returned before owned refresh completed")
+	}
+	startDNSPull(ctx, server, "late-stale.fixture.", feature.IPOption{IPv4Enable: true})
+	if server.queries.Load() != 1 {
+		t.Fatal("closed owner admitted a late stale refresh")
+	}
+}
