+)
+
+// These fixtures only use ephemeral loopback listeners and a fixture CA. They
+// never disable TLS verification, contact a provider, or replace global roots.
+func salfetkaDNSAnswer(t *testing.T, payload []byte) ([]byte, string) {
+	t.Helper()
+	var query dnsmessage.Message
+	if err := query.Unpack(payload); err != nil || len(query.Questions) != 1 {
+		return nil, ""
+	}
+	question := query.Questions[0]
+	answer := dnsmessage.Message{Header: dnsmessage.Header{ID: query.ID, Response: true,
+		RecursionAvailable: true}, Questions: query.Questions}
+	if question.Type == dnsmessage.TypeA {
+		answer.Answers = []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: question.Name,
+			Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 60},
+			Body: &dnsmessage.AResource{A: [4]byte{192, 0, 2, 42}}}}
+	}
+	encoded, err := answer.Pack()
+	if err != nil {
+		t.Error("synthetic DNS answer", err)
+	}
+	return encoded, question.Name.String()
+}
+
+func salfetkaDNSFeature(t *testing.T, server Server) *DNS {
+	t.Helper()
+	ctx, owner := newDNSOwnedContext(context.Background())
+	hosts, err := NewStaticHosts(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	option := &feature.IPOption{IPv4Enable: true}
+	return &DNS{ctx: ctx, owner: owner, hosts: hosts, ipOption: option,
+		clients: []*Client{{server: server, ipOption: option, timeoutMs: 5 * time.Second}}}
+}
+
+func salfetkaDNSLookup(t *testing.T, owner *DNS, domain string) {
+	t.Helper()
+	ips, _, err := owner.LookupIP(domain, feature.IPOption{IPv4Enable: true})
+	if err != nil || len(ips) != 1 || !ips[0].Equal(net.IPv4(192, 0, 2, 42)) {
+		t.Fatal("verified fixture lookup", err, ips)
+	}
+}
+
+func TestSalfetkaDNSCloseOwnsDoHActiveIdleAndLateSockets(t *testing.T) {
+	var requests atomic.Int32
+	var mu sync.Mutex
+	live := map[net.Conn]bool{}
+	blocked := make(chan struct{}, 4)
+	fixture := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		payload, err := io.ReadAll(io.LimitReader(r.Body, 4096))
+		if err != nil {
+			return
+		}
+		answer, name := salfetkaDNSAnswer(t, payload)
+		requests.Add(1)
+		if strings.HasPrefix(name, "blocked-") {
+			blocked <- struct{}{}
+			<-r.Context().Done()
+			return
+		}
+		w.Header().Set("Content-Type", "application/dns-message")
+		_, _ = w.Write(answer)
+	}))
+	fixture.EnableHTTP2 = true
+	fixture.Config.ConnState = func(c net.Conn, state http.ConnState) {
+		mu.Lock()
+		defer mu.Unlock()
+		if state == http.StateNew {
+			live[c] = true
+		}
+		if state == http.StateClosed {
+			delete(live, c)
+		}
+	}
+	fixture.StartTLS()
+	defer fixture.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(fixture.Certificate())
+	makeServer := func() *DoHNameServer {
+		u, _ := url.Parse(fixture.URL)
+		s := NewDoHNameServer(u, nil, false, false, false, 0, nil)
+		transport := s.httpClient.Transport.(*http2.Transport)
+		transport.DialTLSContext = func(ctx context.Context, network, address string, _ *tls.Config) (net.Conn, error) {
+			dialer := tls.Dialer{Config: &tls.Config{RootCAs: roots, NextProtos: []string{"h2"}}}
+			conn, err := dialer.DialContext(ctx, network, address)
+			if err != nil {
+				return nil, err
+			}
+			return s.ownDNSConn(conn)
+		}
+		return s
+	}
+	foreign := salfetkaDNSFeature(t, makeServer())
+	defer foreign.Close()
+	salfetkaDNSLookup(t, foreign, "foreign-first.fixture")
+	for run := 0; run < 3; run++ {
+		server := makeServer()
+		owner := salfetkaDNSFeature(t, server)
+		salfetkaDNSLookup(t, owner, fmt.Sprintf("owned-%d.fixture", run))
+		var activeDone chan error
+		if run > 0 {
+			activeDone = make(chan error, 1)
+			go func() {
+				_, _, err := owner.LookupIP(fmt.Sprintf("blocked-%d.fixture", run), feature.IPOption{IPv4Enable: true})
+				activeDone <- err
+			}()
+			select {
+			case <-blocked:
+			case <-time.After(time.Second):
+				t.Fatal("active DoH fixture did not receive query")
+			}
+		}
+		if err := owner.Close(); err != nil {
+			t.Fatal("owned Close", err)
+		}
+		if err := owner.Close(); err != nil {
+			t.Fatal("idempotent Close", err)
+		}
+		if activeDone != nil {
+			select {
+			case err := <-activeDone:
+				if err == nil {
+					t.Fatal("Close did not cancel active query")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("Close left owned query running")
+			}
+		}
+		deadline := time.Now().Add(time.Second)
+		for {
+			mu.Lock()
+			count := len(live)
+			mu.Unlock()
+			if count == 1 {
+				break
+			}
+			if time.Now().After(deadline) {
+				t.Fatal("owned idle/active sockets remained, or foreign socket closed", count)
+			}
+			time.Sleep(time.Millisecond)
+		}
+		before := requests.Load()
+		if _, _, err := owner.LookupIP("after-close.fixture", feature.IPOption{IPv4Enable: true}); err == nil {
+			t.Fatal("closed owner admitted a new lookup")
+		}
+		if requests.Load() != before {
+			t.Fatal("closed owner sent another query")
+		}
+		late, peer := net.Pipe()
+		if conn, err := server.ownDNSConn(late); err == nil || conn != nil {
+			t.Fatal("late socket escaped closed owner")
+		}
+		_ = peer.SetReadDeadline(time.Now().Add(time.Second))
+		if _, err := peer.Read(make([]byte, 1)); err != io.EOF {
+			t.Fatal("late socket was not closed", err)
+		}
+		_ = peer.Close()
+		salfetkaDNSLookup(t, foreign, fmt.Sprintf("foreign-survives-%d.fixture", run))
+	}
+}
