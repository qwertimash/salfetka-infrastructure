+func TestSalfetkaDNSCloseOwnsDoQConnectionAndRefusesReconnect(t *testing.T) {
+	// httptest supplies a test-only signed certificate with IP SANs; reuse it
+	// for verified QUIC instead of importing a system root or skipping verify.
+	certFixture := httptest.NewTLSServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))
+	certificate, parsed := certFixture.TLS.Certificates[0], certFixture.Certificate()
+	certFixture.Close()
+	roots := x509.NewCertPool()
+	roots.AddCert(parsed)
+	listener, err := quic.ListenAddr("127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{certificate},
+		NextProtos: []string{NextProtoDQ}}, &quic.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	serverConnections := make(chan *quic.Conn, 2)
+	go func() {
+		for n := 0; n < 2; n++ {
+			connection, err := listener.Accept(ctx)
+			if err != nil {
+				return
+			}
+			serverConnections <- connection
+		}
+	}()
+	makeServer := func() (*QUICNameServer, *DNS, *quic.Conn) {
+		connection, err := quic.DialAddr(ctx, listener.Addr().String(), &tls.Config{RootCAs: roots,
+			ServerName: "127.0.0.1", NextProtos: []string{NextProtoDQ}}, &quic.Config{})
+		if err != nil {
+			t.Fatal("verified QUIC fixture", err)
+		}
+		var remote *quic.Conn
+		select {
+		case remote = <-serverConnections:
+		case <-ctx.Done():
+			t.Fatal("QUIC fixture accept")
+		}
+		u, _ := url.Parse("quic+local://" + listener.Addr().String())
+		s, err := NewQUICNameServer(u, false, false, 0, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		s.connection = connection
+		return s, salfetkaDNSFeature(t, s), remote
+	}
+	server, owner, remote := makeServer()
+	foreignServer, foreign, foreignRemote := makeServer()
+	defer foreign.Close()
+	var hits atomic.Int32
+	blocked := make(chan struct{}, 1)
+	serve := func(conn *quic.Conn, block bool) {
+		for {
+			stream, err := conn.AcceptStream(ctx)
+			if err != nil {
+				return
+			}
+			var length [2]byte
+			if _, err = io.ReadFull(stream, length[:]); err != nil {
+				return
+			}
+			payload := make([]byte, binary.BigEndian.Uint16(length[:]))
+			if _, err = io.ReadFull(stream, payload); err != nil {
+				return
+			}
+			answer, _ := salfetkaDNSAnswer(t, payload)
+			hits.Add(1)
+			if block {
+				blocked <- struct{}{}
+				<-conn.Context().Done()
+				return
+			}
+			binary.BigEndian.PutUint16(length[:], uint16(len(answer)))
+			_, _ = stream.Write(append(length[:], answer...))
+			_ = stream.Close()
+		}
+	}
+	go serve(remote, true)
+	go serve(foreignRemote, false)
+	salfetkaDNSLookup(t, foreign, "foreign-quic-first.fixture")
+	activeDone := make(chan error, 1)
+	go func() {
+		_, _, err := owner.LookupIP("blocked-quic.fixture", feature.IPOption{IPv4Enable: true})
+		activeDone <- err
+	}()
+	select {
+	case <-blocked:
+	case <-ctx.Done():
+		t.Fatal("owned active QUIC query missing")
+	}
+	if err := owner.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-remote.Context().Done():
+	case <-time.After(time.Second):
+		t.Fatal("owned QUIC connection remained open")
+	}
+	select {
+	case err := <-activeDone:
+		if err == nil {
+			t.Fatal("active QUIC query survived Close")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("QUIC owned query was not drained")
+	}
+	if conn, err := server.getConnection(context.Background()); err == nil || conn != nil {
+		t.Fatal("closed QUIC server reconnected")
+	}
+	if _, err := foreignServer.getConnection(ctx); err != nil {
+		t.Fatal("foreign QUIC connection was closed", err)
+	}
+	salfetkaDNSLookup(t, foreign, "foreign-quic-survives.fixture")
+	if hits.Load() != 3 {
+		t.Fatal("unexpected owned reconnect or missing foreign lookup", hits.Load())
+	}
+}
