+func TestSalfetkaDNSInheritedContextUsesOwnerLifetimeWithoutQueryCallbacks(t *testing.T) {
+	type valueKey string
+	parent, cancel := context.WithDeadline(context.WithValue(context.Background(), valueKey("source"), "not inherited"), time.Now().Add(time.Minute))
+	defer cancel()
+	source, owner := newDNSOwnedContext(parent)
+	destination := context.WithValue(context.Background(), valueKey("destination"), "preserved")
+	for range 10000 {
+		inherited := inheritDNSOwnedContext(destination, source)
+		if inherited.Done() != owner.ctx.Done() {
+			t.Fatal("inherit created a query cancellation lifetime instead of reusing the owner")
+		}
+		if got := inherited.Value(valueKey("destination")); got != "preserved" {
+			t.Fatalf("destination value changed: %v", got)
+		}
+		if inherited.Value(valueKey("source")) != nil || inherited.Value(dnsOwnerKey{}) != owner {
+			t.Fatal("owner attachment leaked unrelated source values")
+		}
+		deadline, ok := inherited.Deadline()
+		expected, _ := owner.ctx.Deadline()
+		if !ok || !deadline.Equal(expected) {
+			t.Fatal("owner deadline lost")
+		}
+	}
+	inherited := inheritDNSOwnedContext(destination, source)
+	child, childCancel := context.WithCancel(inherited)
+	defer childCancel()
+	owner.cancelTasks()
+	select {
+	case <-child.Done():
+		if child.Err() != context.Canceled || inherited.Err() != context.Canceled {
+			t.Fatal("owner cancellation not inherited")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("owner cancellation did not reach derived DNS work")
+	}
+}
