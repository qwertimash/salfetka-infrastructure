+type salfetkaHeldCachedServer struct {
+	cache    *CacheController
+	queries  atomic.Int32
+	started  chan struct{}
+	finished chan struct{}
+}
+
+func (s *salfetkaHeldCachedServer) getCacheController() *CacheController { return s.cache }
+func (s *salfetkaHeldCachedServer) sendQuery(ctx context.Context, _ chan<- error, _ string, _ feature.IPOption) {
+	s.queries.Add(1)
+	close(s.started)
+	<-ctx.Done()
+	close(s.finished)
+}
