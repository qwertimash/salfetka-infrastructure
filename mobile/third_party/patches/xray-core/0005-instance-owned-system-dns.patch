diff --git a/transport/internet/salfetka_system_context.go b/transport/internet/salfetka_system_context.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_system_context.go
@@ -0,0 +1,30 @@
+package internet
+
+import (
+	"context"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/outbound"
+)
+
+type systemDialerKey struct{}
+type SystemDialerProvider func() (dns.Client, outbound.Manager)
+
+// The provider is attached by core.toContext and resolves this instance's own
+// features, including contexts created before all features were constructed.
+func ContextWithSystemDialerProvider(ctx context.Context, provider SystemDialerProvider) context.Context {
+	return context.WithValue(ctx, systemDialerKey{}, provider)
+}
+func systemDialerFeatures(ctx context.Context) (dns.Client, outbound.Manager) {
+	if provider, ok := ctx.Value(systemDialerKey{}).(SystemDialerProvider); ok {
+		return provider()
+	}
+	systemDialerAccess.RLock()
+	defer systemDialerAccess.RUnlock()
+	return dnsClient, obm
+}
+func InheritSystemDialerContext(destination, source context.Context) context.Context {
+	if provider, ok := source.Value(systemDialerKey{}).(SystemDialerProvider); ok {
+		destination = ContextWithSystemDialerProvider(destination, provider)
+	}
+	return destination
+}
diff --git a/transport/internet/salfetka_system_context_test.go b/transport/internet/salfetka_system_context_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_system_context_test.go
@@ -0,0 +1,46 @@
+package internet
+
+import (
+	"context"
+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/features/dns"
+	"github.com/xtls/xray-core/features/outbound"
+	"sync"
+	"testing"
+)
+
+type scopedDNS struct{ ip net.IP }
+
+func (*scopedDNS) Type() interface{} { return dns.ClientType() }
+func (*scopedDNS) Start() error      { return nil }
+func (*scopedDNS) Close() error      { return nil }
+func (d *scopedDNS) LookupIP(string, dns.IPOption) ([]net.IP, uint32, error) {
+	return []net.IP{d.ip}, 1, nil
+}
+func TestSalfetkaSystemDNSIsInstanceOwnedUnderParallelInit(t *testing.T) {
+	dc, om := systemDialerFeatures(context.Background())
+	t.Cleanup(func() { InitSystemDialer(dc, om) })
+	first := &scopedDNS{net.ParseIP("192.0.2.1")}
+	second := &scopedDNS{net.ParseIP("192.0.2.2")}
+	contexts := []context.Context{ContextWithSystemDialerProvider(context.Background(), func() (dns.Client, outbound.Manager) { return first, nil }), ContextWithSystemDialerProvider(context.Background(), func() (dns.Client, outbound.Manager) { return second, nil })}
+	var workers sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		workers.Add(1)
+		go func(index int) {
+			defer workers.Done()
+			for n := 0; n < 100; n++ {
+				InitSystemDialer(second, nil)
+				ctx := InheritSystemDialerContext(context.Background(), contexts[index])
+				ips, err := LookupForIPContext(ctx, "synthetic.invalid", DomainStrategy_USE_IP4, nil)
+				if err != nil || len(ips) != 1 || !ips[0].Equal([]net.IP{first.ip, second.ip}[index]) {
+					t.Error("source DNS crossed instance", err)
+				}
+			}
+		}(i)
+	}
+	workers.Wait()
+	missing := ContextWithSystemDialerProvider(context.Background(), func() (dns.Client, outbound.Manager) { return nil, nil })
+	if _, err := LookupForIPContext(missing, "synthetic.invalid", DomainStrategy_USE_IP4, nil); err == nil {
+		t.Fatal("missing own feature fell back to foreign global")
+	}
+}
