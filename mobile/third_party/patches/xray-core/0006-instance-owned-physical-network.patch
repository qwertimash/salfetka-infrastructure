diff --git a/transport/internet/salfetka_network_context.go b/transport/internet/salfetka_network_context.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_network_context.go
@@ -0,0 +1,76 @@
+package internet
+
+import (
+	"context"
+	"fmt"
+	"github.com/xtls/xray-core/common/net"
+	"strconv"
+	"syscall"
+)
+
+type systemNetworkKey struct{}
+type systemNetworkScope struct {
+	control  func(string, string, syscall.RawConn) error
+	resolver *net.Resolver
+}
+
+// Only the trusted app host supplies these functions. Config JSON cannot opt
+// into a socket binding or replace the source's DNS/routing configuration.
+func ContextWithSystemNetworkScope(ctx context.Context, control func(string, string, syscall.RawConn) error, resolver *net.Resolver) context.Context {
+	return context.WithValue(ctx, systemNetworkKey{}, systemNetworkScope{control, resolver})
+}
+func SystemNetworkScoped(ctx context.Context) bool {
+	_, ok := ctx.Value(systemNetworkKey{}).(systemNetworkScope)
+	return ok
+}
+func SystemResolver(ctx context.Context) *net.Resolver {
+	if scope, ok := ctx.Value(systemNetworkKey{}).(systemNetworkScope); ok {
+		if scope.control == nil || scope.resolver == nil {
+			// A malformed host scope must not panic or select the OS resolver.
+			return &net.Resolver{PreferGo: true, StrictErrors: true, Dial: func(context.Context, string, string) (net.Conn, error) {
+				return nil, fmt.Errorf("measurement network scope unavailable")
+			}}
+		}
+		return scope.resolver
+	}
+	return net.DefaultResolver
+}
+func applySystemNetworkControl(ctx context.Context, network, address string, raw syscall.RawConn) error {
+	if scope, ok := ctx.Value(systemNetworkKey{}).(systemNetworkScope); ok {
+		if scope.control == nil || scope.resolver == nil {
+			return fmt.Errorf("measurement network scope unavailable")
+		}
+		return scope.control(network, address, raw)
+	}
+	return nil
+}
+func inheritSystemNetworkScope(destination, source context.Context) context.Context {
+	if scope, ok := source.Value(systemNetworkKey{}).(systemNetworkScope); ok {
+		return context.WithValue(destination, systemNetworkKey{}, scope)
+	}
+	return destination
+}
+func ResolveSystemUDPAddr(ctx context.Context, address string) (*net.UDPAddr, error) {
+	if !SystemNetworkScoped(ctx) {
+		return net.ResolveUDPAddr("udp", address)
+	}
+	host, port, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	number, err := strconv.Atoi(port)
+	if err != nil || number < 0 || number > 65535 {
+		return nil, fmt.Errorf("invalid UDP port")
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		return &net.UDPAddr{IP: ip, Port: number}, nil
+	}
+	ips, err := SystemResolver(ctx).LookupIPAddr(ctx, host)
+	if err != nil {
+		return nil, err
+	}
+	if len(ips) == 0 {
+		return nil, fmt.Errorf("empty bound resolver response")
+	}
+	return &net.UDPAddr{IP: ips[0].IP, Port: number, Zone: ips[0].Zone}, nil
+}
diff --git a/transport/internet/salfetka_network_context_test.go b/transport/internet/salfetka_network_context_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/salfetka_network_context_test.go
@@ -0,0 +1,64 @@
+package internet
+
+import (
+	"context"
+	"errors"
+	"github.com/xtls/xray-core/common/net"
+	"sync/atomic"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestSalfetkaPhysicalScopeFailClosedTCPAndUDP(t *testing.T) {
+	blocked := errors.New("synthetic interface bind rejected")
+	var controls atomic.Int32
+	resolver := &net.Resolver{PreferGo: true, StrictErrors: true, Dial: func(context.Context, string, string) (net.Conn, error) { return nil, blocked }}
+	scope := ContextWithSystemNetworkScope(context.Background(), func(string, string, syscall.RawConn) error { controls.Add(1); return blocked }, resolver)
+	ctx, cancel := context.WithTimeout(InheritSystemDialerContext(context.Background(), scope), time.Second)
+	defer cancel()
+	for _, address := range []string{"127.0.0.1", "::1"} {
+		for _, network := range []net.Network{net.Network_TCP, net.Network_UDP} {
+			dest := net.Destination{Address: net.ParseAddress(address), Port: net.Port(1), Network: network}
+			connection, err := (&DefaultSystemDialer{}).Dial(ctx, nil, dest, nil)
+			if connection != nil {
+				connection.Close()
+				t.Fatal("binding failure opened socket")
+			}
+			if !errors.Is(err, blocked) {
+				t.Fatal("binding error not returned", address, network, err)
+			}
+		}
+	}
+	if controls.Load() != 4 {
+		t.Fatal("some TCP/UDP sockets skipped binding", controls.Load())
+	}
+}
+
+func TestSalfetkaPhysicalScopeDNSInheritanceAndMalformedNoFallback(t *testing.T) {
+	blocked := errors.New("synthetic scoped DNS unavailable")
+	var queries atomic.Int32
+	r := &net.Resolver{PreferGo: true, StrictErrors: true, Dial: func(context.Context, string, string) (net.Conn, error) { queries.Add(1); return nil, blocked }}
+	control := func(string, string, syscall.RawConn) error { return nil }
+	scope := ContextWithSystemNetworkScope(context.Background(), control, r)
+	ctx, cancel := context.WithTimeout(InheritSystemDialerContext(context.Background(), scope), time.Second)
+	defer cancel()
+	if !SystemNetworkScoped(ctx) || SystemResolver(ctx) != r {
+		t.Fatal("detached transport lost owned resolver")
+	}
+	if _, err := ResolveSystemUDPAddr(ctx, "synthetic-measure.test:53"); err == nil || queries.Load() == 0 {
+		t.Fatal("UDP bootstrap ignored scoped DNS", err)
+	}
+	if _, err := (&DefaultSystemDialer{}).Dial(ctx, nil, net.TCPDestination(net.DomainAddress("synthetic-measure.test"), 1), nil); err == nil {
+		t.Fatal("TCP bootstrap ignored scoped DNS")
+	}
+	for _, malformed := range []context.Context{ContextWithSystemNetworkScope(ctx, nil, r), ContextWithSystemNetworkScope(ctx, control, nil)} {
+		before := queries.Load()
+		if _, err := ResolveSystemUDPAddr(malformed, "synthetic-measure.test:53"); err == nil {
+			t.Fatal("malformed scope fell back DNS")
+		}
+		if queries.Load() != before {
+			t.Fatal("malformed scope used otherwise valid resolver")
+		}
+	}
+}
