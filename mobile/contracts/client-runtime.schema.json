{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salfetka.invalid/schemas/client-runtime-v2",
  "title": "Salfetka ordinary VPN list runtime catalog v2",
  "description": "Internal URI-list conversion. Source expiry unknown: expires_at must be absent. VPN/xray only; same verified packet probe and DNS validation. Not an entitlement grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "revision",
    "profiles",
    "dns_servers",
    "probe"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "dns_servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "format": "ipv4"
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "ipv4",
        "expected_status",
        "body_sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "No userinfo, query or fragment. TLS hostname verification is mandatory; no redirect follow."
        },
        "ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "expected_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mode",
          "exit_country",
          "engine",
          "settings"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "No control characters; never export names in diagnostics."
          },
          "mode": {
            "const": "vpn"
          },
          "exit_country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "engine": {
            "const": "xray"
          },
          "settings": {
            "type": "object",
            "description": "Private engine adapter settings; never log or include in UI state."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
