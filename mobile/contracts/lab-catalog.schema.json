{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salfetka.invalid/schemas/lab-catalog-v1",
  "title": "Salfetka manually imported laboratory catalog v1",
  "description": "Maximum UTF-8 file size 524288 bytes. Expiry must be in the future; IDs must be unique. This is not production entitlement. Native and Go validators enforce these extra invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "revision", "expires_at", "profiles", "dns_servers", "probe"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "dns_servers": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "format": "ipv4"}},
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "ipv4", "expected_status", "body_sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "description": "No userinfo, query or fragment. TLS hostname verification is mandatory; no redirect follow."},
        "ipv4": {"type": "string", "format": "ipv4"},
        "expected_status": {"type": "integer", "minimum": 200, "maximum": 299},
        "body_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "mode", "exit_country", "engine", "settings"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1, "maxLength": 64, "description": "No control characters; never export names in diagnostics."},
          "mode": {"enum": ["vpn", "bypass"]},
          "exit_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "engine": {"enum": ["xray", "olcrtc", "openflux"]},
          "settings": {"type": "object", "description": "Private engine adapter settings; never log or include in UI state."}
        },
        "allOf": [{"if": {"properties": {"mode": {"const": "vpn"}}}, "then": {"properties": {"engine": {"const": "xray"}}}, "else": {"properties": {"engine": {"enum": ["olcrtc", "openflux"]}}}}]
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}}
}
