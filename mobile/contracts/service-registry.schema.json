{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salfetka.invalid/schemas/service-registry-v1",
  "title": "Trusted packaged service registry (not subscription input)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "revision",
    "services",
    "presets"
  ],
  "properties": {
    "format": {
      "const": "salfetka.service_registry"
    },
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "services": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "revision",
          "matchers",
          "sources",
          "coverage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "category": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "matchers": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/routing_matcher"
            },
            "minItems": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "coverage": {
            "const": "domains_only"
          },
          "ios_discovery": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheme",
                "source"
              ],
              "properties": {
                "scheme": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9+.-]{1,31}$"
                },
                "source": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      }
    },
    "presets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "revision",
          "services",
          "matchers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "services": {
            "type": "array",
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          },
          "matchers": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/routing_matcher"
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "services": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "matchers": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "routing_matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "domain_exact",
            "domain_suffix",
            "ip_cidr",
            "geosite",
            "geoip"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        }
      }
    },
    "routing_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "action": {
          "enum": [
            "tunnel",
            "direct"
          ]
        },
        "match": {
          "$ref": "#/$defs/routing_matcher"
        }
      }
    },
    "routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "default_action",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "default_action": {
          "const": "tunnel"
        },
        "rules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/routing_rule"
          }
        }
      }
    }
  }
}
