{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted Android routing startup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "subscription_id",
    "interface_name",
    "network_handle",
    "host_package",
    "applied_packages"
  ],
  "properties": {
    "format": {
      "const": "salfetka.android_routing_start"
    },
    "version": {
      "const": 1
    },
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "interface_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "network_handle": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "host_package": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
      "maxLength": 255
    },
    "applied_packages": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
        "maxLength": 255
      }
    },
    "preferences": {
      "$ref": "routing-preferences.schema.json"
    }
  }
}
